{
  "name": "sr-enterprises-inventory",
  "version": "1.0.0",
  "private": true,
  "description": "SR Enterprises Inventory Management System",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "create-admin": "tsx scripts/create-admin.ts",
    "create-user": "tsx scripts/create-user.ts",
    "test": "tsx --test lib/billing/calc.test.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "chart.js": "4.4.1",
    "html2canvas": "1.4.1",
    "jose": "5.9.6",
    "jspdf": "2.5.2",
    "next": "14.2.15",
    "papaparse": "^5.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.16.11",
    "@types/papaparse": "^5.5.2",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "prisma": "5.22.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  }
}
