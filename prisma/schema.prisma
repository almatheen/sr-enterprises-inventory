generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum StockMovementType {
  INITIAL
  ADD
  REMOVE
  DAMAGE
  RETURN
  CORRECTION
  SALE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  theme        String   @default("light")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Single-row business configuration.
/// The application uses "business" as the default ID.
model Business {
  id                String   @id @default("business")
  name              String   @default("SR ENTERPRISES")
  tagline           String   @default("Mobile • Toys • Accessories")
  address           String   @default("")
  phone             String   @default("")
  email             String   @default("")
  gstin             String   @default("")
  state             String   @default("")
  pincode           String   @default("")
  logo              String?  @db.Text
  invoicePrefix     String   @default("SR-INV")
  lowStockThreshold Int      @default(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Safe, transactional sequences.
/// Used for product IDs per category and invoice numbers per year.
model Counter {
  key   String @id
  value Int    @default(0)
}

model Product {
  id            String   @id @default(cuid())
  uniqueId      String   @unique
  name          String
  sku           String   @unique
  barcode       String?  @unique
  category      String
  brand         String   @default("")
  description   String   @default("")
  purchasePrice Decimal  @db.Decimal(12, 2)
  sellingPrice  Decimal  @db.Decimal(12, 2)
  gst           Int      @default(18)
  stock         Int      @default(0)
  minimumStock  Int      @default(10)
  supplier      String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items           InvoiceItem[]
  movements       StockMovement[]
  SalesReturnItem SalesReturnItem[]

  @@index([category])
  @@index([name])
  @@index([stock])
}

model Client {
  id             String   @id @default(cuid())
  name           String
  phone          String   @unique
  email          String   @default("")
  gstin          String   @default("")
  address        String   @default("")
  state          String   @default("")
  totalPurchases Decimal  @default(0) @db.Decimal(14, 2)
  outstanding    Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices Invoice[]

  @@index([name])
}

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  customerId String?
  customer   Client? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Customer snapshot at time of sale.
  // Walk-in customers can have no Client row.
  customerName    String @default("")
  customerPhone   String @default("")
  customerEmail   String @default("")
  customerGstin   String @default("")
  customerAddress String @default("")

  subtotal      Decimal @db.Decimal(14, 2)
  discountType  String  @default("pct")
  discountValue Decimal @default(0) @db.Decimal(12, 2)
  discount      Decimal @db.Decimal(14, 2)

  cgst       Decimal @db.Decimal(14, 2)
  sgst       Decimal @db.Decimal(14, 2)
  igst       Decimal @db.Decimal(14, 2)
  tax        Decimal @db.Decimal(14, 2)
  roundOff   Decimal @db.Decimal(6, 2)
  grandTotal Decimal @db.Decimal(14, 2)

  amountPaid Decimal @db.Decimal(14, 2)
  balance    Decimal @db.Decimal(14, 2)
  costTotal  Decimal @default(0) @db.Decimal(14, 2)

  interState    Boolean @default(false)
  paymentMethod String
  status        String  @default("Paid")

  createdAt DateTime @default(now())

  items       InvoiceItem[]
  SalesReturn SalesReturn[]

  @@index([createdAt])
  @@index([customerId])
  @@index([customerPhone])
  @@index([paymentMethod])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Product snapshot.
  // This keeps historical invoice data stable even if
  // the product is later edited or deleted.
  name     String
  sku      String
  category String

  quantity Int

  price           Decimal           @db.Decimal(12, 2)
  cost            Decimal           @default(0) @db.Decimal(12, 2)
  gst             Int
  amount          Decimal           @db.Decimal(14, 2)
  SalesReturnItem SalesReturnItem[]

  @@index([invoiceId])
  @@index([productId])
}

model StockMovement {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type StockMovementType

  /// Signed change applied to stock.
  /// Negative values represent removals/sales.
  quantity Int

  /// Product stock balance after this movement.
  balance Int

  reason    String   @default("")
  userId    String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

enum SalesReturnReason {
  CUSTOMER_CHANGED_MIND
  WRONG_PRODUCT
  DAMAGED_PRODUCT
  MANUFACTURING_DEFECT
  NOT_WORKING
  INCORRECT_SIZE_OR_MODEL
  OTHER
}

enum ReturnedProductCondition {
  RESALABLE
  NEEDS_INSPECTION
  DAMAGED
}

enum ReturnStatus {
  RECORDED
  COMPLETED
  CANCELLED
}

model SalesReturn {
  id           String  @id @default(cuid())
  returnNumber String  @unique
  invoiceId    String?
  invoice      Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  customerName String            @default("")
  reason       SalesReturnReason
  notes        String            @default("")
  status       ReturnStatus      @default(RECORDED)

  processedById String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items SalesReturnItem[]

  @@index([invoiceId])
  @@index([createdAt])
  @@index([status])
}

model SalesReturnItem {
  id          String      @id @default(cuid())
  returnId    String
  salesReturn SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  invoiceItemId String?
  invoiceItem   InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName String
  sku         String
  quantity    Int
  condition   ReturnedProductCondition
  restocked   Boolean                  @default(false)
  notes       String                   @default("")

  @@index([returnId])
  @@index([invoiceItemId])
  @@index([productId])
}
